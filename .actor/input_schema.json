{
    "title": "Dynamic Web Scraper",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "startSources": {
            "title": "Start Sources",
            "type": "array",
            "description": "Sources to start with, could be .",
            "editor": "stringList",
            "prefill": ["Lucerna Bar Cafe, Prague"],
            "minItems": 1
        },
        "prompt": {
            "title": "Prompt",
            "type": "string",
            "editor": "textarea",
            "description": "Prompt to evaluate on content.",
            "prefill": "Look for the food menu items and if you find it look for a chicken option"
        },
        "maxDepth": {
            "title": "Max Depth",
            "type": "integer",
            "description": "Maximum depth to scrape.",
            "default": 3
        },
        "multipleTargets": {
            "title": "Multiple Targets",
            "type": "boolean",
            "description": "Continue exploring after each found result to collect multiple matches per source (e.g. all news articles about a topic).",
            "default": false
        },
        "model": {
            "title": "LLM Model",
            "type": "string",
            "description": "LLM model to use via OpenRouter. See https://openrouter.ai/models for full list.",
            "editor": "select",
            "enum": [
                "openrouter/auto",
                "google/gemini-2.5-flash-lite",
                "openai/gpt-4o-mini",
                "google/gemini-2.0-flash-001",
                "anthropic/claude-haiku-4-5",
                "meta-llama/llama-4-scout"
            ],
            "enumTitles": [
                "Auto (OpenRouter selects best)",
                "Gemini 2.5 Flash Lite (Google)",
                "GPT-4o Mini (OpenAI)",
                "Gemini 2.0 Flash (Google)",
                "Claude Haiku 4.5 (Anthropic)",
                "Llama 4 Scout (Meta)"
            ],
            "default": "google/gemini-2.5-flash-lite"
        }
    },
    "required": [
        "startSources",
        "prompt"
    ]
}
